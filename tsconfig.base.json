{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "mfeUsers/Routes": [
        "./apps/mfeUsers/src/app/remote-entry/entry.routes.ts"
      ],
      "mfeProducts/Routes": [
        "./apps/mfeProducts/src/app/remote-entry/entry.routes.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
